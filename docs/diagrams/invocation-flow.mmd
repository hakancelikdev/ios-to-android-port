flowchart TD
    START(["/ios-port invocation"]) --> CHECK["parity_check.sh"]
    CHECK --> STATUS{"STATUS"}

    STATUS -- "BOOTSTRAP<br/>first run" --> BOOT["Inventory the iOS app and the Android repo<br/>write the ledger in dependency order"]
    BOOT --> BOOTCOMMIT["commit + push the ledger"] --> END1(["end — owner reviews the ledger"])

    STATUS -- "RESUME<br/>a doing row is left over" --> RESUME["finish it, or revert it<br/>and set the row back to todo"] --> PICK
    STATUS -- "MULTI_DOING" --> MULTI["keep one doing<br/>set the rest back to todo"] --> PICK
    STATUS -- "WORK" --> PICK["take NEXT_TODO<br/>row becomes doing"]
    STATUS -- "QUEUE_EXHAUSTED" --> SYNC

    PICK --> READ["Read iOS: View, ViewModel, Domain, tokens<br/>citations generated by ios_cite.sh"]
    READ --> BUILD["Build it on Android<br/>port the values, restyle Material until it looks like iOS"]
    BUILD --> DOD["Definition of Done<br/>iOS-pinned tests, every language, tokens, analytics, changelog"]
    DOD --> GATE{"Quality gate<br/>FORMAT_CMD, GATE_CMD, ledger check"}

    GATE -- "red, try again<br/>up to about 6 times" --> BUILD
    GATE -- "still red" --> BLOCKED
    GATE -- "green" --> REVIEW{"parity-reviewer<br/>staged diff vs iOS"}

    REVIEW -- "must-fix" --> BUILD
    REVIEW -- "needs an owner decision" --> BLOCKED["revert the partial code<br/>row becomes blocked, with the reason"]
    REVIEW -- "approve" --> COMMIT["feature commit<br/>ledger commit: done + SHA<br/>push"]

    COMMIT --> NEXT(["next invocation"])
    BLOCKED --> THREE{"3 blocked in a row?"}
    THREE -- "no" --> NEXT
    THREE -- "yes" --> OWNER(["stop and summarize for the owner"])

    SYNC["ios_sync_scan.sh<br/>new iOS commits since the marker?"]
    SYNC -- "yes" --> NEWROWS["open todo rows<br/>advance the marker"] --> PICK
    SYNC -- "no" --> GAP["Experience-gap scan<br/>one area, iOS and Android side by side"]
    GAP -- "differences found" --> GAPROWS["open todo rows"] --> PICK
    GAP -- "none" --> DONE(["parity report — the loop stops itself"])
