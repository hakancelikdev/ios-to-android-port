# port.env — configuration for the iOS → Android port loop.
# Copy to tools/port/port.env (install.sh does this) and edit. Paths are relative to the Android repo root.
# Plain KEY=VALUE lines; quote values that contain spaces. Read by every script in tools/port/.

# --- iOS reference (the specification) --------------------------------------------------------
# Your iOS repo checkout. It is read, never written: no commit, pull or branch switch from the loop.
IOS_REPO="../MyApp-iOS"
# The loop only reads this branch. If the checkout is on any other branch it stops, because a
# release/feature branch would port unreleased behavior.
IOS_BRANCH="main"
# Swift source root inside IOS_REPO (ios_cite.sh searches it; citations are relative to IOS_REPO).
IOS_SRC="MyApp"
# Directories (inside IOS_REPO) whose commits count as user-facing for the iOS-sync scan.
IOS_SYNC_PATHS="MyApp MyAppWidgets"
# First-run fallback for the iOS-sync scan (before a marker exists): the port's start date.
IOS_SYNC_SINCE="2026-01-01"

# --- Localization (optional: ios_strings_import.py / ios_stale_strings.py) -------------------
# Directory inside IOS_REPO that holds <lang>.lproj/Localizable.strings (+ .stringsdict).
IOS_LOCALIZATION="MyApp/Resources"
# iOS language → Android values folder. The first entry is the base language (values/).
LANGS="en:values tr:values-tr"
ANDROID_RES="app/src/main/res"
# File the importer generates in every values folder (never hand-edited).
ANDROID_STRINGS_FILE="strings_ios.xml"

# --- Android app ------------------------------------------------------------------------------
ANDROID_PKG="com.example.myapp.debug"
ANDROID_ACTIVITY="com.example.myapp.MainActivity"
# Kotlin source root the loop greps for "iOS `SwiftName`" KDoc markers.
ANDROID_SRC="app/src/main/kotlin"

# --- Quality gate -----------------------------------------------------------------------------
# Everything that must be green before a commit. parity_check.sh is appended automatically.
# Make it as strict as your project allows: the loop is only as good as this gate.
GATE_CMD="./gradlew :app:assembleDebug :app:testDebugUnitTest :app:lintDebug"
# Formatter run BEFORE the gate (import order is the most common reason a correct change fails it).
FORMAT_CMD="./gradlew :app:detektFormat"
# Launch the app once after touching a screen or startup path — the gate never starts the app.
RUN_CMD="./gradlew :app:installDebug"
# Optional: clean shells often can't find Java. Leave empty to use the environment.
JAVA_HOME_OVERRIDE="/Applications/Android Studio.app/Contents/jbr/Contents/Home"

# --- Commit / push ----------------------------------------------------------------------------
# The loop commits and pushes every finished task. "main" pushes straight to the default branch
# (the original workflow: main stays green because nothing is committed before the gate passes).
# Set e.g. "port/autopilot" to collect the work on a branch and open PRs yourself.
PUSH_REMOTE="origin"
PUSH_BRANCH="main"
